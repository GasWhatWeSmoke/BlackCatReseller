# SQLite database file (Prisma resolves file: URLs relative to prisma/schema.prisma).
# This puts the DB at <project>/data/black-cat.db
DATABASE_URL="file:../data/black-cat.db"

# Absolute path to the same SQLite file, used by the Python worker (sqlite3).
# Leave blank to let the worker auto-resolve <project>/data/black-cat.db
BLACKCAT_DB_PATH=

# Media data root (incoming/processing/ready/archive/...). Configurable later in
# Settings; this env is only the first-run default. Default: <project>/var
BLACKCAT_DATA_ROOT=

# Path to the Python interpreter inside the worker venv. The Electron/Next side
# spawns this. Default: <project>/worker/.venv/Scripts/python.exe (Windows)
BLACKCAT_PYTHON=

# Fixed localhost port the Next.js server binds to (localhost only).
PORT=41999
